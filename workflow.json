          "cachedResultName": "models/gemini-2.5-flash"
        },
        "text": "=Eres un experto en infraestructura urbana. Analiza la imagen y la descripción del reporte ciudadano.\n\nDebes responder ÚNICAMENTE con un JSON válido (sin markdown, sin comillas triples, sin texto extra) con esta estructura exacta:\n\n{\n  \"categoria\": \"Vías | Eléctrico | Acueducto | Semáforos | Espacio Público\",\n  \"prioridad\": \"Crítica | Alta | Moderada | Baja\",\n  \"confianza\": \"95%\",\n  \"resumen\": \"Un resumen ejecutivo de 1 oración sobre el daño y la acción recomendada.\"\n}\n\nDescripción del ciudadano: {{ $json.body.descripcion }}",
        "inputType": "binary",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        -1040,
        32
      ],
      "id": "1399750f-71df-4647-9092-985db384cba7",
      "name": "Analyze an image",
      "credentials": {
        "googlePalmApi": {
          "id": "ZH0i4pd98Vi40qRa",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst base64Data = items[0].json.body.fotoBase64;\n\n// Limpiar el prefijo \"data:image/jpeg;base64,\"\nconst base64String = base64Data.includes(',') ? base64Data.split(',')[1] : base64Data;\nconst buffer = Buffer.from(base64String, 'base64');\n\nreturn [{\n  json: items[0].json,\n  binary: {\n    data: {\n      data: buffer,\n      mimeType: 'image/jpeg',\n      fileName: 'reporte.jpg'\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1248,
        32
      ],
      "id": "403fd389-5c15-4472-ab9d-1ce878749991",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Verificar si hay datos\nif (!items || !items[0] || !items[0].json) {\n  return [{\n    json: {\n      error: \"No hay datos de entrada\",\n      categoria: \"Espacio Público\",\n      prioridad: \"Moderada\",\n      confianza: \"100%\",\n      resumen: \"Error en el procesamiento. Intente nuevamente.\",\n      ticketId: 'SC-' + Math.floor(1000 + Math.random() * 9000),\n      ruta: 'revision',\n      timestamp: new Date().toISOString()\n    }\n  }];\n}\n\nconst geminiResponse = items[0].json;\n\n// La respuesta de Gemini viene en content.parts[0].text\nlet aiResponse = null;\n\ntry {\n  // Estructura correcta de Gemini 2.5\n  if (geminiResponse.candidates && geminiResponse.candidates[0]) {\n    aiResponse = geminiResponse.candidates[0].content.parts[0].text;\n  } else if (geminiResponse.content && geminiResponse.content.parts) {\n    aiResponse = geminiResponse.content.parts[0].text;\n  } else {\n    throw new Error(\"Estructura de respuesta no reconocida\");\n  }\n\n  if (!aiResponse) {\n    throw new Error(\"No se obtuvo texto de la respuesta\");\n  }\n\n  // Limpiar markdown y obtener JSON\n  const cleanJson = aiResponse\n    .replace(/```json\\n?/g, '')\n    .replace(/```/g, '')\n    .trim();\n\n  // Parsear JSON\n  const parsed = JSON.parse(cleanJson);\n  \n  // Generar ID único\n  const ticketId = 'SC-' + Math.floor(1000 + Math.random() * 9000);\n  \n  // Lógica de criticidad\n  let ruta = 'normal';\n  const confianzaNum = parseInt(parsed.confianza) || 0;\n  \n  if (parsed.prioridad === 'Crítica' && confianzaNum >= 85) {\n    ruta = 'urgente';\n  } else if (parsed.prioridad === 'Baja' || confianzaNum < 60) {\n    ruta = 'revision';\n  }\n  \n  return [{\n    json: {\n      categoria: parsed.categoria || \"Espacio Público\",\n      prioridad: parsed.prioridad || \"Moderada\",\n      confianza: parsed.confianza || \"100%\",\n      resumen: parsed.resumen || \"Análisis realizado\",\n      ticketId: ticketId,\n      ruta: ruta,\n      timestamp: new Date().toISOString()\n    }\n  }];\n  \n} catch (e) {\n  console.error('Error:', e.message);\n  \n  return [{\n    json: {\n      error: e.message,\n      categoria: \"Espacio Público\",\n      prioridad: \"Moderada\",\n      confianza: \"100%\",\n      resumen: \"Análisis automático realizado por IA.\",\n      ticketId: 'SC-' + Math.floor(1000 + Math.random() * 9000),\n      ruta: 'normal',\n      timestamp: new Date().toISOString()\n    }\n  }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
