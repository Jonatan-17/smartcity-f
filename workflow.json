    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const messageText = item.json.message.text || \"\";\n  const chatId = item.json.message.chat.id;\n  const userName = item.json.message.from.first_name || \"Ciudadano\";\n  \n  // Limpiar el texto: quitar espacios y convertir a mayúsculas\n  const ticketId = messageText.trim().toUpperCase();\n  \n  // Validar formato del Ticket ID (debe ser SC-XXXX)\n  const ticketPattern = /^SC-\\d{4}$/;\n  const esValido = ticketPattern.test(ticketId);\n  \n  results.push({\n    json: {\n      chatId: chatId,\n      ticketId: ticketId,\n      userName: userName,\n      mensajeOriginal: messageText,\n      esValido: esValido,\n      timestamp: new Date().toISOString()\n    }\n  });\n}\n\nreturn results;"
      },
