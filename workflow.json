    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst ticketId = $('Code in JavaScript2').item.json.ticketId;\nconst chatId = $('Code in JavaScript2').item.json.chatId;\nconst userName = $('Code in JavaScript2').item.json.userName;\n\n// Verificar si Google Sheets realmente encontró algo\n// Cuando no encuentra, devuelve null o un objeto vacío\nif (items.length === 0 || !items[0] || !items[0].json || Object.keys(items[0].json).length === 0) {\n  return [{\n    json: {\n      chatId: chatId,\n      ticketId: ticketId,\n      userName: userName,\n      encontrado: false\n    }\n  }];\n}\n\nconst rowData = items[0].json;\n\n// Verificar si el Ticket ID coincide (por si hay falsos positivos)\nif (!rowData[\"Ticket ID\"] || rowData[\"Ticket ID\"] !== ticketId) {\n  return [{\n    json: {\n      chatId: chatId,\n      ticketId: ticketId,\n      userName: userName,\n      encontrado: false\n    }\n  }];\n}\n\n// Si todo está bien, devolver los datos\nreturn [{\n  json: {\n    chatId: chatId,\n    ticketId: ticketId,\n    userName: userName,\n    encontrado: true,\n    categoria: rowData[\"Categoria\"] || \"No especificada\",\n    prioridad: rowData[\"Prioridad \"] || rowData[\"Prioridad\"] || \"No asignada\",\n    confianza: rowData[\"Confianza \"] || rowData[\"Confianza\"] || \"0%\",\n    resumen: rowData[\"Resumen \"] || rowData[\"Resumen\"] || \"Sin resumen\",\n    estado: rowData[\"estado ticket\"] || \"Pendiente\"\n  }\n}];"
      },
